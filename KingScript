local AimToggleBtn = nil
local IsAimOn = false

-- دالة موحدة لتحديث حالة الأيم لوك في كل مكان
local function SyncAimLock(state)
    IsAimOn = state
    aLock = state
    
    -- 1. تحديث الزر العائم
    if FB then
        FB.Text = state and "AIM\nON" or "AIM\nOFF"
        T:Create(FB, TweenInfo.new(0.2), {BackgroundColor3 = state and Color3.fromRGB(10,80,10) or Color3.fromRGB(60,10,10)}):Play()
    end
    
    -- 2. تحديث زر الواجهة (إذا كان موجود)
    if AimToggleBtn and AimToggleBtn.Parent then
        AimToggleBtn.Text = state and "ON" or "OFF"
        T:Create(AimToggleBtn, TweenInfo.new(0.2), {BackgroundColor3 = state and Color3.fromRGB(10,80,10) or Color3.fromRGB(60,10,10)}):Play()
    end
end

