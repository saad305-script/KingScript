R.RenderStepped:Connect(function()
    if not aLock then FC.Visible=false return end
    FC.Visible=true FC.Size=UDim2.new(0,fR*2,0,fR*2)
    local cT, sD, c = nil, fR, Cam.ViewportSize/2
    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    rayParams.IgnoreWater = true
    rayParams.FilterDescendantsInstances = {LP.Character, Cam}
    for _,p in pairs(P:GetPlayers()) do
        if p~=LP and p.Character then
            local h=p.Character:FindFirstChild("Head") local hm=p.Character:FindFirstChildOfClass("Humanoid")
            if h and hm and hm.Health>0 then
                local sp, os = Cam:WorldToViewportPoint(h.Position)
                if os then
                    local d=(Vector2.new(sp.X,sp.Y)-c).Magnitude
                    if d<sD then
                        local canSee=true
                        if wChk then
                            local filterList = {LP.Character, Cam}
                            for _, part in ipairs(p.Character:GetDescendants()) do
                                if part:IsA("BasePart") then table.insert(filterList, part) end
                            end
                            rayParams.FilterDescendantsInstances = filterList
                            local direction = (h.Position - Cam.CFrame.Position)
                            local result = workspace:Raycast(Cam.CFrame.Position, direction, rayParams)
                            if result and not result.Instance:IsDescendantOf(p.Character) then canSee = false end
                        end
                        if canSee then sD=d cT=p end
                    end
                end
            end
        end
    end
    if cT and cT.Character and cT.Character:FindFirstChild("Head") then
        local targetPos = cT.Character.Head.Position
        Cam.CFrame = Cam.CFrame:Lerp(CFrame.new(Cam.CFrame.Position, targetPos), 1-aSm)
    end
end)

R.RenderStepped:Connect(function()
    if not nRec then return end
    local ch=LP.Character if not ch then return end
    if Cam:FindFirstChild("CameraShake") then Cam.CameraShake:Destroy() end
    local t=ch:FindFirstChildOfClass("Tool")
    if t then for _,o in pairs(t:GetDescendants()) do if o:IsA("NumberValue") then local n=o.Name:lower() if n:find("recoil") or n:find("kick") or n:find("shake") then o.Value=0 end end end end
    local h=ch:FindFirstChildOfClass("Humanoid") if h then h.CameraOffset=Vector3.new(0,0,0) end
end)

R.RenderStepped:Connect(function()
    if not noSpreadEnabled then return end
    local ch = LP.Character
    if not ch then return end
    local t = ch:FindFirstChildOfClass("Tool")
    if t then
        for _, obj in ipairs(t:GetDescendants()) do
            if obj:IsA("NumberValue") then
                local n = obj.Name:lower()
                if n:find("spread") or n:find("deviation") or n:find("inaccuracy") then
                    obj.Value = 0
                end
            end
        end
    end
end)

-- Text ESP (Loot + Health)
local activeEsp = {}
local function Esp(p)
    if p==LP then return end
    local function onC(c)
        if c:FindFirstChild("LootESP") then c.LootESP:Destroy() end
        local hrp = c:WaitForChild("HumanoidRootPart", 5) 
        if hrp then
            local b = Instance.new("BillboardGui", hrp) 
            b.Name = "LootESP" 
            b.Size = UDim2.new(0, 150, 0, 50) 
            b.StudsOffset = Vector3.new(0, -3, 0) 
            b.AlwaysOnTop = true
            b.Enabled = lootEspEnabled 
            local container = Instance.new("Frame", b)
            container.Size = UDim2.new(1,0,1,0)
            container.BackgroundTransparency = 1
            activeEsp[p] = b
            task.spawn(function() 
                while c.Parent do 
                    container:ClearAllChildren()
                    local layout = Instance.new("UIListLayout", container)
                    layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
                    layout.VerticalAlignment = Enum.VerticalAlignment.Bottom
                    layout.Padding = UDim.new(0, 1)
                    local tools = {}
                    if p:FindFirstChild("Backpack") then
                        for _, t in ipairs(p.Backpack:GetChildren()) do
                            if t:IsA("Tool") and t.Name:lower() ~= "fists" then table.insert(tools, t) end
                        end
                    end
                    for _, t in ipairs(c:GetChildren()) do
                        if t:IsA("Tool") and t.Name:lower() ~= "fists" then table.insert(tools, t) end
                    end
                    for _, tool in ipairs(tools) do
                        local lbl = Instance.new("TextLabel", container)
                        lbl.Size = UDim2.new(0, 150, 0, 14)
                        lbl.BackgroundTransparency = 1
                        lbl.Text = tool.Name
                        lbl.TextColor3 = Color3.fromRGB(255, 255, 255)
                        lbl.TextStrokeTransparency = 0.4
                        lbl.Font = Enum.Font.GothamBold
                        lbl.TextSize = 12
                        lbl.TextScaled = true
                    end
                    task.wait(0.5) 
                end 
            end)
        end
        if c:FindFirstChild("HealthESP") then c.HealthESP:Destroy() end
        local head = c:WaitForChild("Head", 5)
        if head then
            local hb = Instance.new("BillboardGui", head) 
            hb.Name = "HealthESP" 
            hb.Size = UDim2.new(0, 100, 0, 20) 
            hb.StudsOffset = Vector3.new(0, 2.5, 0) 
            hb.AlwaysOnTop = true
            hb.Enabled = healthEspEnabled 
            local healthLbl = Instance.new("TextLabel", hb)
            healthLbl.Size = UDim2.new(1,0,1,0)
            healthLbl.BackgroundTransparency = 1
            healthLbl.TextColor3 = Color3.fromRGB(255, 50, 50)
            healthLbl.TextStrokeTransparency = 0
            healthLbl.Font = Enum.Font.GothamBold
            healthLbl.TextSize = 14
            healthLbl.TextScaled = true
            task.spawn(function()
                while c.Parent do
                    local hum = c:FindFirstChildOfClass("Humanoid")
                    if hum then
                        hb.Enabled = healthEspEnabled
                        if healthEspEnabled then
                            healthLbl.Text = "❤️ " .. math.floor(hum.Health) .. " / " .. math.floor(hum.MaxHealth)
                        end
                    else
                        hb.Enabled = false
                    end
                    task.wait(0.2)
                end
            end)
        end
    end
    if p.Character then onC(p.Character) end 
    p.CharacterAdded:Connect(onC)
end
for _,p in pairs(P:GetPlayers()) do Esp(p) end 
P.PlayerAdded:Connect(Esp)

task.spawn(function()
    while task.wait(0.5) do
        for _, b in pairs(activeEsp) do
            if b and b.Parent then b.Enabled = lootEspEnabled end
        end
    end
end)
