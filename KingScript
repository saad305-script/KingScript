local LP = Players.LocalPlayer
local Cam = Workspace.CurrentCamera
local PG = LP:WaitForChild("PlayerGui")

local T = {
    Black = Color3.fromRGB(10,10,12), Dark = Color3.fromRGB(20,20,25), Light = Color3.fromRGB(35,35,45),
    Gold = Color3.fromRGB(255,190,0), Glow = Color3.fromRGB(255,215,0), White = Color3.fromRGB(240,240,240), Gray = Color3.fromRGB(150,150,150)
}

local S = { ESP = false, Aim = false, Silent = false, Part = "Head", Range = 300, Smooth = 0.15 }
local Target, ESPTab, RenderConn, Tween, SilentConn = nil, {}, nil, nil, nil

local function Stop()
    if RenderConn then RenderConn:Disconnect() RenderConn = nil end
    if SilentConn then SilentConn:Disconnect() SilentConn = nil end
    if Tween then Tween:Cancel() Tween = nil end
    Target = nil
end

local function GetTarget()
    local c, d = nil, S.Range
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LP and p.Character then
            local h = p.Character:FindFirstChildOfClass("Humanoid")
            if h and h.Health > 0 then
                local pt = p.Character:FindFirstChild(S.Part)
                if pt then
                    local _, on = Cam:WorldToViewportPoint(pt.Position)
                    if on then
                        local dist = (Cam.CFrame.Position - pt.Position).Magnitude
                        if dist < d then d = dist c = p.Character end
                    end
                end
            end
        end
    end
    return c
end

local function StartAim()
    Stop()
    RenderConn = RunService.RenderStepped:Connect(function()
        if not S.Aim then Stop() return end
        if not Target or not Target.Parent then Target = GetTarget() end
        if Target then
            local pt = Target:FindFirstChild(S.Part)
            if pt then
                if Tween then Tween:Cancel() end
                Tween = TweenService:Create(Cam, TweenInfo.new(S.Smooth, Enum.EasingStyle.Sine), {CFrame = CFrame.lookAt(Cam.CFrame.Position, pt.Position)})
                Tween:Play()
            end
        end
    end)
end

local function StartSilent()
    Stop()
    local m = LP:GetMouse()
    if not m then return end
    
    -- إصلاح مشكلة الحماية في بعض البرامج
    local success, mt = pcall(getrawmetatable, game)
    if success and mt then
        local old = mt.__index
        setreadonly(mt, false)
        mt.__index = newcclosure(function(self, k)
            if S.Silent and self == m and (k == "Hit" or k == "Target") then
                local t = Target or GetTarget()
                if t then
                    local pt = t:FindFirstChild(S.Part)
                    if pt then Target = t return pt end
                end
            end
            return old(self, k)
        end)
        setreadonly(mt, true)
    end
    
    SilentConn = RunService.RenderStepped:Connect(function()
        if not S.Silent then Stop() return end
        if not Target or not Target.Parent then Target = GetTarget() end
    end)
end

local function RefreshESP()
    for char, hl in pairs(ESPTab) do
        if not char.Parent or not hl.Parent then ESPTab[char] = nil else hl.Enabled = S.ESP end
    end
    if S.ESP then
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LP and p.Character and not ESPTab[p.Character] then
                local hl = Instance.new("Highlight")
                hl.Adornee = p.Character
                hl.FillColor = T.Gold
                hl.FillTransparency = 0.6
                hl.OutlineColor = T.Glow
                hl.OutlineTransparency = 0
                hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                hl.Parent = p.Character
                ESPTab[p.Character] = hl
            end
        end
    end
end

